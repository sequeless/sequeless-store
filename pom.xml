<?xml version="1.0" encoding="UTF-8"?>
<!--
  Aggregator only. Never released or deployed.
  Modules take their parent from sequeless-build-parent, not from this POM, so the
  repository entry is repeated in each module POM.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.sequeless</groupId>
  <artifactId>sequeless-store</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>sequeless-store</name>
  <description>Command side store: object state, outbox, validation, derivation and the Postgres adapter for them</description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <modules>
    <module>store-core</module>
    <module>store-testkit</module>
  </modules>

  <repositories>
    <repository>
      <id>github</id>
      <url>https://maven.pkg.github.com/sequeless/*</url>
      <snapshots><enabled>true</enabled></snapshots>
    </repository>
  </repositories>
</project>
