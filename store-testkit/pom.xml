<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Pinned to a released sequeless-build-parent. Renovate bumps it. -->
  <parent>
    <groupId>org.sequeless</groupId>
    <artifactId>sequeless-build-parent</artifactId>
    <version>0.1.3</version>
    <relativePath/>
  </parent>

  <groupId>org.sequeless</groupId>
  <artifactId>store-testkit</artifactId>
  <version>0.1.0</version>
  <name>store-testkit</name>
  <description>Store testkit: in-memory doubles, the reference-domain fixtures and the contract tests for the store's Command ports. No Spring.</description>

  <properties>
    <!-- The deploy URL is built from this name; it must name this repository (the parent defaults to sequeless-build). -->
    <sequeless.github.repository>sequeless-store</sequeless.github.repository>
    <!-- Matches the other Sequeless library modules: JDK 25. -->
    <maven.compiler.release>25</maven.compiler.release>
    <!-- Opts in to the parent's enforcer ban on Spring, Jena and Lombok: the testkit has no Spring. -->
    <sequeless.enforcer.core.skip>false</sequeless.enforcer.core.skip>
    <!-- Published: the BOM resolves it. Released by release-please, first at 0.1.0. -->
    <maven.deploy.skip>false</maven.deploy.skip>
    <junit.version>6.1.3</junit.version>
    <sequeless-bom.version>0.3.2</sequeless-bom.version>
    <!-- No framework BOM here: the testkit names no framework, so these two versions are pinned explicitly. -->
    <assertj.version>3.27.7</assertj.version>
    <jackson-bom.version>2.21.5</jackson-bom.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>
      <!-- Jackson 2 family: one BOM keeps databind, core and annotations on the same line. -->
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>sequeless-bom</artifactId>
        <version>${sequeless-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>store-core</artifactId>
      <version>0.1.0</version>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>kernel-identity</artifactId>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>kernel-values</artifactId>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>schema-contract</artifactId>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>behaviour-contract</artifactId>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>ontology-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>ontology-testfixtures</artifactId>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>filter-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- The contract classes live in src/main/java, and adapter modules extend them from their own test code, so JUnit and AssertJ must propagate at compile scope. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <repositories>
    <repository>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
      <id>github</id>
      <url>https://maven.pkg.github.com/sequeless/*</url>
    </repository>
  </repositories>
</project>
